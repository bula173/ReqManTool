# ReqManTool - Docker ignore patterns

# Git
.git
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/
.env
.env.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend build output (built during Docker build)
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local development
.reqman/
example_database/
*.log

# Test outputs
.tmp/
tmp/

# Secrets and config (use docker-compose env_file instead)
config.json
server.env
*.env
*.env.local
*.secret
*.key
*.pem
*.crt

# Documentation
docs/
README.md
CHANGELOG.md
CONTRIBUTING.md