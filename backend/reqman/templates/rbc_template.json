      "id": "object_type",
      "name": "Object Type",
      "type": "enum",
      "required": false,
      "default": null,
      "choices": ["Heading", "Requirement", "Information", "Definition", "Assumption", "Test Case"]
    },
    {
      "id": "status",
      "name": "Status",
      "type": "enum",
      "required": false,
      "default": "Draft",
      "choices": ["Draft", "Proposed", "Reviewed", "Approved", "Rejected", "Deleted"]
    },
    {
      "id": "sil",
      "name": "SIL",
      "type": "enum",
      "required": false,
      "default": null,
      "choices": ["Basic Integrity", "SIL 1", "SIL 2", "SIL 3", "SIL 4"],
      "modules": ["strs", "syrs", "swrs"]
    },
    {
      "id": "safety_related",
      "name": "Safety Related",
      "type": "boolean",
      "required": false,
      "default": false,
      "choices": null
