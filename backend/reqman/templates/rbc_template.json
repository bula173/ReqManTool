      "module_template": "builtin:operational_scenarios",
      "skeleton": [
        {
          "heading": "Introduction"
        },
        {
          "heading": "Actors and Roles",
          "text": "Driver, signaller / RBC operator, onboard ERTMS/ETCS unit, interlocking, neighbouring RBC and maintainer."
        },
        {
          "heading": "Normal Operation",
          "children": [
            {
              "heading": "Start of Mission"
            },
            {
              "heading": "Movement Authority Extension"
