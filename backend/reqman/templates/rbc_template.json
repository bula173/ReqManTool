{
  "format_version": 2,
  "id": "rbc_template",
  "name": "RBC_Template",
  "description": "ERTMS/ETCS Radio Block Centre project structured for the CENELEC railway standards EN 50126 (RAMS), EN 50128 (software) and EN 50129 (safety-related electronic systems): stakeholder, system and software requirements with system and software test specifications and their test executions, traced V-model style.",
  "attributes": [
