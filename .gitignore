# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Node
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/

# C/C++
*.o
*.obj
*.exe
*.out
*.a
*.so

# Logs
*.log

# Mutation testing (mutmut): generated mutants, never commit
/backend/mutants/
mutants/
.mutmut-cache/

# Documentation build output (generated by Doxygen/Sphinx, deployed as artifacts)
/docs/sphinx/_build/
/quality/docs/build/

# ReqManTool requirements data (created at runtime, not source)
/example_database/
/backend/data/
/.reqman/

# Release build (etc/build-dist.sh): frontend and licence copies bundled into the package
/backend/reqman/static/
/backend/reqman/BUILD
/backend/LICENSE

# Desktop app (Tauri): generated backend bundle, logs and cargo output
# (etc/start-desktop.sh and .github/workflows/desktop.yml produce these)
/desktop/src-tauri/backend/
/desktop/src-tauri/target/
/desktop/.logs/
