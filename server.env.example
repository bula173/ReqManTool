# ReqManTool Server Edition - Secrets
# Copy to server.env and fill in your values
# This file is git-ignored; never commit secrets!

# GitHub OAuth App client secret
REQMAN_AUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# GitLab OAuth App client secret
REQMAN_AUTH_GITLAB_CLIENT_SECRET=your-gitlab-client-secret

# OIDC provider client secret (if using OIDC)
# REQMAN_AUTH_OIDC_CLIENT_SECRET=your-oidc-client-secret

# Licence file path (if using server edition licence)
# REQMAN_LICENCE_FILE=/licence.json